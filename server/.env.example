# Copy to .env and adjust as needed. Every value below has a working
# default already (see src/config.js), so this file is optional for local
# development - MongoDB just needs to be running on the default port.

# PORT=4000
# MONGO_URI=mongodb://127.0.0.1:27017/helpdeskly
# REQUIRED in production: the server refuses to start with NODE_ENV=production
# unless this is set to a unique secret (e.g. `openssl rand -hex 32`).
# JWT_SECRET=change-me-to-a-long-random-string-in-production
# JWT_EXPIRES_IN=7d
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to the number of reverse proxies in front of the API so rate limiting
# sees real client IPs (e.g. 1).
# TRUST_PROXY=1
